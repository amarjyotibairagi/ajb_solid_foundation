[Unit]
Description={{PRODUCT_NAME}} individual-user (B2C) app and API
After=network-online.target {{APP_SLUG}}-pgbouncer@public.service
Wants=network-online.target
Requires={{APP_SLUG}}-pgbouncer@public.service

[Service]
Type=simple
User={{APP_SLUG}}-public
Group={{APP_SLUG}}-public
WorkingDirectory={{INSTALL_DIR}}
Environment=NODE_ENV=production
EnvironmentFile={{CONFIG_DIR}}/env/public.env
ExecStart={{NODE_BIN}} {{INSTALL_DIR}}/backend/public/dist/server.js
ExecStartPost={{INSTALL_DIR}}/scripts/wait-for-origin.sh localhost http://127.0.0.1:{{PUBLIC_PORT}}/api/health
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
MemoryMax=768M
TasksMax=256
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome={{PROTECT_HOME}}
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
ReadOnlyPaths={{INSTALL_DIR}}

[Install]
WantedBy=multi-user.target
