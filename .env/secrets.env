# =============================================================================
#  Credentials you supply (all optional, depending on setup.env)
# =============================================================================
# Keep this file private (chmod 600). setup.sh copies what it needs into
# CONFIG_DIR/secrets with root-only permissions. Nothing generated by the
# installer is ever written back here.

# --- Cloudflare (EDGE_MODE=cloudflare-api) ------------------------------------
# API token scoped to one account and one zone with:
#   Account > Cloudflare Tunnel > Edit
#   Account > Turnstile > Edit
#   Zone    > DNS > Edit
# The admin panel's DNS page also uses it (Zone > DNS > Edit is enough there).
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=

# --- Cloudflare (EDGE_MODE=cloudflare-token) ----------------------------------
# Token of an existing remotely-managed tunnel (Zero Trust > Networks > Tunnels).
CLOUDFLARE_TUNNEL_TOKEN=

# --- Turnstile (LOGIN_CHALLENGE=turnstile and EDGE_MODE is not cloudflare-api)
# One widget per sign-in surface. The tenant widget must allow ROOT_DOMAIN so
# it works on every tenant subdomain.
TURNSTILE_PLATFORM_SITE_KEY=
TURNSTILE_PLATFORM_SECRET_KEY=
TURNSTILE_PUBLIC_SITE_KEY=
TURNSTILE_PUBLIC_SECRET_KEY=
TURNSTILE_TENANT_SITE_KEY=
TURNSTILE_TENANT_SECRET_KEY=

# --- Invitation delivery (optional) -------------------------------------------
# When set, invitation links are POSTed as signed JSON to this relay, which
# sends the email/SMS. When empty, links are shown once to whoever issued them.
NOTIFICATION_WEBHOOK_URL=
NOTIFICATION_WEBHOOK_SECRET=
