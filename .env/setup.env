# =============================================================================
#  Platform setup decisions
# =============================================================================
# Every value that shapes the installation lives here. Edit it before running
#   sudo ./setup.sh check      (validates this file and the host, changes nothing)
#   sudo ./setup.sh install    (installs or upgrades)
#
# This file holds no secrets. Credentials you already have (Cloudflare API
# token, Turnstile keys, webhook secret) go in .env/secrets.env. Passwords the
# platform needs are generated during install and stored in CONFIG_DIR, never
# in this folder.
#
# Syntax: KEY=value, sourced by bash. Quote values containing spaces.
# ${APP_SLUG} and other earlier keys may be referenced.

# -----------------------------------------------------------------------------
# 1. Identity
# -----------------------------------------------------------------------------
# Shown in the admin panel, sign-in pages and the landing page.
PRODUCT_NAME="My Platform"
# Short lowercase name (letters, digits, hyphen; 2-20 chars). Used for system
# users (<slug>-platform, <slug>-tenant...) and systemd units. Two copies of
# this folder on one server need different slugs and ports.
APP_SLUG=myplatform
# The domain you control. Tenants get <name>.ROOT_DOMAIN.
ROOT_DOMAIN=example.com
# Subdomains for the operator console and the individual-user (B2C) app. Both
# are reserved automatically so no tenant can claim them.
PLATFORM_SUBDOMAIN=platform
PUBLIC_SUBDOMAIN=user
# Optional contact address shown on the landing page.
CONTACT_EMAIL=

# Landing page copy.
BRAND_TAGLINE="One platform for your organizations and people"
BRAND_DESCRIPTION="Sign in to manage your workspace."

# -----------------------------------------------------------------------------
# 2. First platform owner
# -----------------------------------------------------------------------------
# Created on the first install. A strong password is generated and written to
# CONFIG_DIR/secrets/initial-owner.txt (root only). Sign in, enrol a security
# key when prompted, then delete that file.
OWNER_USERNAME=owner
OWNER_DISPLAY_NAME="Platform Owner"

# -----------------------------------------------------------------------------
# 3. Public edge (how the internet reaches this server)
# -----------------------------------------------------------------------------
# cloudflare-api    Fully automatic. Creates a Cloudflare Tunnel, DNS records
#                   (apex, www, platform, user, *) and three Turnstile widgets.
#                   Needs CLOUDFLARE_ACCOUNT_ID, CLOUDFLARE_ZONE_ID and
#                   CLOUDFLARE_API_TOKEN in .env/secrets.env. Recommended.
# cloudflare-token  Runs an existing remotely-managed tunnel from
#                   CLOUDFLARE_TUNNEL_TOKEN. You add the public hostnames in
#                   the Cloudflare dashboard (README lists them).
# none              No tunnel. Put your own TLS reverse proxy in front of the
#                   loopback ports below (README has the mapping). HTTPS is
#                   required: security keys (WebAuthn) only work over HTTPS.
EDGE_MODE=cloudflare-api
CLOUDFLARE_TUNNEL_NAME=${APP_SLUG}

# Human verification on sign-in pages:
# turnstile  Cloudflare Turnstile (keys created automatically in cloudflare-api
#            mode, otherwise set them in .env/secrets.env).
# none       No challenge. Throttling and rate limits still apply. Only for
#            private sandboxes.
LOGIN_CHALLENGE=turnstile

# -----------------------------------------------------------------------------
# 4. Platform defaults (all changeable later in the admin panel)
# -----------------------------------------------------------------------------
# dedicated: each tenant gets its own database login (strongest isolation).
# pooled:    tenants share one login and pool (for many small tenants).
DEFAULT_CONNECTION_TIER=dedicated
# memory: single process per service (this installer's layout).
# postgres: share throttles and rate limits across processes and hosts.
SHARED_STATE_BACKEND=memory
# Allow tenants to bring their own S3-compatible storage and PostgreSQL.
# A sealing key is generated when true.
ENABLE_INTEGRATIONS=true
# Verify each new tenant hostname over the public internet before activating
# it. auto = only when EDGE_MODE=cloudflare-api.
TENANT_EDGE_VERIFY=auto

# -----------------------------------------------------------------------------
# 5. Locations
# -----------------------------------------------------------------------------
# The platform installs into the folder containing setup.sh, wherever it was
# unpacked (e.g. /opt/myplatform or /srv/myplatform):
#   ./           code, run in place
#   ./runtime/   config, generated secrets, database, tenant files, logs, Node.js
#   ./backups/   encrypted backups (default location)
# Every directory above the folder must be traversable by other users, so
# prefer /opt or /srv over a home directory.
#
# Optional: keep backups elsewhere (e.g. a separate disk). Empty = ./backups.
BACKUP_DIR=

# -----------------------------------------------------------------------------
# 6. Software
# -----------------------------------------------------------------------------
# PostgreSQL major version (16 or newer).
PG_VERSION=16
# Node.js major version installed with --install-packages (22 or newer).
NODE_MAJOR=24
# Node binary to use; empty = ./runtime/node if present, else `node` on PATH.
# With --install-packages, a missing Node.js is downloaded into ./runtime/node.
NODE_BIN=

# -----------------------------------------------------------------------------
# 7. Loopback ports (never exposed publicly)
# -----------------------------------------------------------------------------
POSTGRES_PORT=5433
PGBOUNCER_PLATFORM_PORT=3658
PGBOUNCER_PUBLIC_PORT=3659
PGBOUNCER_TENANT_PORT=6360
LANDING_PORT=3651
PLATFORM_PORT=3656
PUBLIC_PORT=3657
TENANT_PORT=6355

# -----------------------------------------------------------------------------
# 8. Operations
# -----------------------------------------------------------------------------
# systemd OnCalendar expression for the daily encrypted backup.
BACKUP_SCHEDULE="*-*-* 02:30:00 UTC"
BACKUP_RETENTION_DAYS=7
# Include tenant files stored on this server in backups.
BACKUP_INCLUDE_STORAGE=true
# How often the health check runs (systemd time span).
HEALTHCHECK_INTERVAL=5min
