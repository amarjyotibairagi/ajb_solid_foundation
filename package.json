{
  "name": "platform-foundation",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "dependency/ui",
    "dependency/platform/CloudFlare",
    "dependency/platform/Drizzle",
    "dependency/platform/ServerKit",
    "backend",
    "backend/provisioner",
    "backend/public",
    "backend/tenant",
    "frontend/landing",
    "frontend/platform",
    "frontend/public",
    "frontend/tenant"
  ],
  "scripts": {
    "dev:landing": "npm run dev --workspace @skeleton/landing",
    "dev:platform": "npm run dev --workspace @skeleton/platform",
    "dev:platform:bff": "npm run dev --workspace @skeleton/backend",
    "dev:public": "npm run dev --workspace @skeleton/public",
    "dev:public:bff": "npm run dev --workspace @skeleton/public-bff",
    "dev:tenant": "npm run dev --workspace @skeleton/tenant",
    "dev:tenant:bff": "npm run dev --workspace @skeleton/tenant-bff",
    "build:backend": "npm run build:backend:platform && npm run build:backend:provisioner && npm run build:backend:public && npm run build:backend:tenant",
    "build:backend:platform": "npm run build --workspace @skeleton/backend",
    "build:backend:provisioner": "npm run build --workspace @skeleton/tenant-provisioner",
    "build:backend:public": "npm run build --workspace @skeleton/public-bff",
    "build:backend:tenant": "npm run build --workspace @skeleton/tenant-bff",
    "start:platform:bff": "npm run start --workspace @skeleton/backend",
    "start:tenant:provisioner": "npm run start --workspace @skeleton/tenant-provisioner",
    "migrate:tenants": "node scripts/migrate-tenants.mjs",
    "bootstrap:runtime-roles": "node scripts/bootstrap-runtime-roles.mjs",
    "start:public:bff": "npm run start --workspace @skeleton/public-bff",
    "start:tenant:bff": "npm run start --workspace @skeleton/tenant-bff",
    "build:cloudflare": "npm run build --workspace @skeleton/cloudflare",
    "build:drizzle": "npm run build --workspace @skeleton/drizzle",
    "build": "npm run build --workspaces --if-present",
    "build:landing": "npm run build --workspace @skeleton/landing",
    "build:platform": "npm run build --workspace @skeleton/platform",
    "build:public": "npm run build --workspace @skeleton/public",
    "build:tenant": "npm run build --workspace @skeleton/tenant",
    "test": "node --test tests/unit/**/*.test.mjs",
    "test:unit": "node --test tests/unit/**/*.test.mjs",
    "test:integration": "node --test tests/integration/**/*.test.mjs",
    "test:restore": "bash scripts/validate-backup-restore.sh",
    "test:smoke:tenant-edge": "node --test tests/smoke/**/*.test.mjs",
    "typecheck": "npm run typecheck:server-kit && npm run typecheck:backend && npm run typecheck:cloudflare && npm run typecheck:drizzle",
    "audit:dependencies": "npm audit",
    "scan:secrets": "node scripts/scan-bundle-secrets.mjs",
    "test:visual": "node scripts/visual-check.mjs",
    "typecheck:backend": "npm run typecheck --workspace @skeleton/backend && npm run typecheck --workspace @skeleton/tenant-provisioner && npm run typecheck --workspace @skeleton/public-bff && npm run typecheck --workspace @skeleton/tenant-bff",
    "typecheck:cloudflare": "npm run typecheck --workspace @skeleton/cloudflare",
    "typecheck:drizzle": "npm run typecheck --workspace @skeleton/drizzle",
    "migrate:platform": "node scripts/platform-migrate.mjs",
    "migrate:platform:apply": "node scripts/platform-migrate.mjs --apply",
    "verify:migrations": "node scripts/platform-migrate.mjs --verify",
    "reconcile:tenants": "node scripts/reconcile-tenants.mjs",
    "verify:tenants": "node scripts/reconcile-tenants.mjs --verify",
    "test:integration:local": "bash scripts/with-test-cluster.sh",
    "build:server-kit": "npm run build --workspace @skeleton/server-kit",
    "typecheck:server-kit": "npm run typecheck --workspace @skeleton/server-kit",
    "setup:check": "bash ./setup.sh check"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "typescript": "7.0.2"
  }
}
